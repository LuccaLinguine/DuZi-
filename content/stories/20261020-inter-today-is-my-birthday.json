  "grammar_points": [
    {
      "pattern": "送给 + person + thing",
      "explanation_en": "送给 means 'to give as a gift to'. Put the receiver after 给 and the gift after the receiver. The person can also be 自己 (oneself).",
      "example_zh": "我送给妈妈一本书。",
      "example_en": "I gave my mom a book as a gift."
    },
    {
      "pattern": "虽然/有点儿……，但是……",
      "explanation_en": "但是 introduces a contrast with what came before. 有点儿 + adjective means 'a bit' and usually describes something slightly negative.",
      "example_zh": "这件衣服有点儿小，但是我很喜欢。",
      "example_en": "This piece of clothing is a bit small, but I like it a lot."
    },
    {
      "pattern": "先/用……（verb）……，然后……",
      "explanation_en": "然后 means 'and then' and links two actions in order. 用 means 'to use' something to do an action.",
      "example_zh": "我想用这个杯子喝茶，然后看书。",
      "example_en": "I want to use this cup to drink tea, and then read a book."
    }
  ],
