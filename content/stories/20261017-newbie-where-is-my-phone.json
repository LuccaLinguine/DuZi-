  "new_words": [],
  "grammar_points": [
    {
      "pattern": "在 + place + 里 / 上",
      "explanation_en": "To say where something is, put 在 before the place and 里 (\"inside\") or 上 (\"on top of\") after it. Chinese needs that second word — 在书包 on its own sounds unfinished.",
      "example_zh": "我的钱在桌子上。",
      "example_en": "My money is on the table."
    },
    {
      "pattern": "A 也 + verb",
      "explanation_en": "也 means \"also\" and always goes before the verb, never at the end of the sentence the way English \"too\" does.",
      "example_zh": "他是学生，我也是学生。",
      "example_en": "He is a student, and I am a student too."
    }
  ],
  "questions": [
    {
      "q_zh": "今天早上她要去哪儿？",
      "q_en": "Where does she have to go this morning?",
      "answer_en": "To school — she has class at eight."
    },
    {
      "q_zh": "谁给她的手机打电话？",
      "q_en": "Who calls her phone?",
      "answer_en": "Her mother."
    },
    {
      "q_zh": "手机在哪里？",
      "q_en": "Where is the phone?",
      "answer_en": "In her clothes — she was carrying it the whole time."
    }
  ]
}
