  "grammar_points": [
    {
      "pattern": "verb + 得 + description",
      "explanation_en": "To say how well someone does something, add 得 after the verb and the description after 得. It describes the doing, not the thing.",
      "example_zh": "她说得很慢。",
      "example_en": "She speaks very slowly."
    },
    {
      "pattern": "又 A 又 B",
      "explanation_en": "Stacks two qualities onto one thing: \"both A and B\". Both A and B must be the same kind of word — two adjectives, or two verbs.",
      "example_zh": "这个房间又大又干净。",
      "example_en": "This room is both big and clean."
    },
    {
      "pattern": "verb + 过",
      "explanation_en": "过 after a verb marks an experience: you have done it at some point. 我吃过 means \"I have eaten (it) before\", not \"I ate it just now\".",
      "example_zh": "我去过北京。",
      "example_en": "I have been to Beijing."
    }
  ],
