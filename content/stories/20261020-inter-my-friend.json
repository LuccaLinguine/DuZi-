  "grammar_points": [
    {
      "pattern": "更 + verb/adjective (even more)",
      "explanation_en": "更 is placed before a verb or adjective to show a higher degree than something already mentioned. 喜欢A，更喜欢B means you like A, but like B even more.",
      "example_zh": "我喜欢咖啡，更喜欢茶。",
      "example_en": "I like coffee, and I like tea even more."
    },
    {
      "pattern": "Verb + 了 + time + 了 (duration up to now)",
      "explanation_en": "Adding 了 at the end of a sentence with a time length shows that a situation has lasted until now and is still continuing.",
      "example_zh": "我们学习中文三年了。",
      "example_en": "We have been studying Chinese for three years."
    },
    {
      "pattern": "一起 + verb (do something together)",
      "explanation_en": "一起 comes before the verb to show that people do the action together. It is often combined with 经常 (often) or 也会 (also will) to describe habits.",
      "example_zh": "周末我们常常一起去公园。",
      "example_en": "On weekends we often go to the park together."
    }
  ],
