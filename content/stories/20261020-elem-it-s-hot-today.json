  "grammar_points": [
    {
      "pattern": "Verb + 了 (completed action)",
      "explanation_en": "Put 了 after a verb to show the action has been completed. It is often used with a number and measure word, like 三节课 or 两杯茶.",
      "example_zh": "我昨天吃了三个苹果。",
      "example_en": "I ate three apples yesterday."
    },
    {
      "pattern": "Adjective + 多了 (much more…)",
      "explanation_en": "Put 多了 after an adjective to say that something is much more that way than before, often showing a change or comparison.",
      "example_zh": "吃了药，我好多了。",
      "example_en": "After taking medicine, I feel much better."
    },
    {
      "pattern": "又 (and then, also, another action)",
      "explanation_en": "又 links a second action that follows the first one, or an action that happens again. Here it adds one more thing she did after buying water.",
      "example_zh": "他先去商店，又去了银行。",
      "example_en": "He went to the store first, and then went to the bank."
    }
  ],
