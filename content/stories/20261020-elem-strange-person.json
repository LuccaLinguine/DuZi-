  "grammar_points": [
    {
      "pattern": "刚……，就……",
      "explanation_en": "Use this to say that one thing happened right after another. 刚 means 'just', and 就 shows the second action followed very quickly.",
      "example_zh": "我刚到家，就下雨了。",
      "example_en": "I had just gotten home when it started to rain."
    },
    {
      "pattern": "……，但是还是……",
      "explanation_en": "Use 但是 (but) to show a contrast, and 还是 (still) to say the action continues in spite of it. The text also uses the short form 但还是.",
      "example_zh": "天气很冷，但是我还是去跑步。",
      "example_en": "The weather is very cold, but I still go running."
    },
    {
      "pattern": "在 + verb",
      "explanation_en": "Put 在 before a verb to show that an action is happening right now.",
      "example_zh": "妈妈在做饭。",
      "example_en": "Mom is cooking."
    }
  ],
  "questions": [
    {
      "q_zh": "男人为什么去了第二间？",
      "q_en": "Why did the man go into the second stall?",
      "answer_en": "Because the first stall was taken."
    },
    {
      "q_zh": "旁边的人问了男人什么？",
      "q_en": "What did the person next to the man ask him?",
      "answer_en": "He asked if the man was doing okay and what he was doing."
    },
    {
      "q_zh": "旁边的人为什么说男人很奇怪？",
      "q_en": "Why did the person next to him say the man was strange?",
      "answer_en": "Because the man kept answering him while he was talking on the phone with someone else."
    }
  ]
