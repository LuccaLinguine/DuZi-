  "grammar_points": [
    {
      "pattern": "虽然……，但是……",
      "explanation_en": "Means 'although... but...'. The first part gives a fact, and the second part gives a contrast. In Chinese you use both words together.",
      "example_zh": "虽然今天很冷，但是我还是去跑步了。",
      "example_en": "Although it is very cold today, I still went running."
    },
    {
      "pattern": "A 像 B 一样 + adjective",
      "explanation_en": "Used to compare two things that are alike: 'A is as ADJ as B'. The adjective tells in what way they are similar.",
      "example_zh": "我的妹妹像小鸟一样爱唱歌。",
      "example_en": "My younger sister loves to sing like a little bird."
    },
    {
      "pattern": "Verb + 得 + adjective (complement of degree)",
      "explanation_en": "After a verb, 得 introduces a description of how the action is done, such as how fast or how well.",
      "example_zh": "他说得很清楚。",
      "example_en": "He speaks very clearly."
    }
  ],
