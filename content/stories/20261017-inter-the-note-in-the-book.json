  "grammar_points": [
    {
      "pattern": "把 + object + verb + result",
      "explanation_en": "The 把 construction moves the object in front of the verb to say what was *done to* it. The verb must have a result attached — 把书介绍给别人 (\"recommend the book to someone\"), never a bare 把书介绍.",
      "example_zh": "请把门关上。",
      "example_en": "Please close the door."
    },
    {
      "pattern": "verb + 着",
