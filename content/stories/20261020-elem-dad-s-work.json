  "grammar_points": [
    {
      "pattern": "疑问代词 + …，(就) 疑问代词 + …(呼应用法)",
      "explanation_en": "The same question word appears twice to mean 'whatever/whoever/wherever... then...'. The first clause sets the condition, and the second clause follows it with the same thing. 就 is often added before the second part.",
      "example_zh": "你想吃什么，我就做什么。",
      "example_en": "I'll cook whatever you want to eat."
    },
    {
      "pattern": "A 让 B + 动词",
      "explanation_en": "让 is a causative verb meaning 'to have/let/make someone do something'. The person who gives the instruction comes before 让, and the person who has to act comes after it.",
      "example_zh": "老师让学生把书打开。",
      "example_en": "The teacher told the students to open their books."
    },
    {
      "pattern": "数词 + 量词 + 的 + 名词 (describing a person by age)",
      "explanation_en": "A number, measure word and 的 can come before a noun to describe it, such as a person's age. Here 五岁的 describes the little girl.",
      "example_zh": "三岁的男孩正在画画。",
      "example_en": "The three-year-old boy is drawing."
    }
  ],
