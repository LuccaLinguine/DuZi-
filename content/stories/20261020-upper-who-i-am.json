  "grammar_points": [
    {
      "pattern": "虽然/…，但是…（A，但是 B）: contrast with 但是",
      "explanation_en": "但是 introduces something that contrasts with or goes against what was said before. The first clause gives the expected or background fact, and the second gives the contrasting one.",
      "example_zh": "我家很小，但是很温暖。",
      "example_en": "My home is small, but it is very warm."
    },
    {
      "pattern": "在 + place + verb",
      "explanation_en": "在 placed before a verb marks the place where an action happens. The text uses it to say where the speaker grew up, studied, and works.",
      "example_zh": "她在法国学做菜。",
      "example_en": "She learns to cook in France."
    },
    {
      "pattern": "A 也很… (也 for 'also')",
      "explanation_en": "也 means 'also' and goes before the verb or adjective, after the subject. It adds a new subject that shares the same quality as the one mentioned before.",
      "example_zh": "我的朋友很忙，我也很忙。",
      "example_en": "My friend is very busy, and I am very busy too."
    }
  ],
