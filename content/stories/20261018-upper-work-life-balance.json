  "grammar_points": [
    {
      "pattern": "越来越多的 + noun",
      "explanation_en": "\"More and more X\" — 越来越 modifies 多, and together they describe a noun whose quantity keeps rising.",
      "example_zh": "越来越多的人喜欢在家工作。",
      "example_en": "More and more people like working from home."
    },
    {
      "pattern": "A 跟 B 不一样",
      "explanation_en": "跟...不一样 (\"different from\") compares two things; the thing compared to goes right after 跟.",
      "example_zh": "他的想法跟我的不一样。",
      "example_en": "His idea is different from mine."
    },
    {
      "pattern": "反而",
      "explanation_en": "\"On the contrary, instead\" — signals a result opposite to what you'd expect from what came before it.",
      "example_zh": "他休息了一天，工作反而做得更快了。",
      "example_en": "He took a day off, and got his work done faster instead."
    }
  ],
