  "grammar_points": [
    {
      "pattern": "因为……，所以……",
      "explanation_en": "Means 'because... so...'. 因为 introduces the reason and 所以 introduces the result. Both are used together in Chinese, unlike in English where we usually use only one.",
      "example_zh": "因为今天下雨，所以我不出去。",
      "example_en": "Because it is raining today, I'm not going out."
    },
    {
      "pattern": "会 + verb (ability)",
      "explanation_en": "会 shows you have learned how to do something. Its negative is 不会. Use it for learned skills like singing, dancing or swimming.",
      "example_zh": "我会做中国菜，但是我不会做日本菜。",
      "example_en": "I can cook Chinese food, but I can't cook Japanese food."
    },
    {
      "pattern": "在 + place + verb",
      "explanation_en": "在 plus a place goes before the verb to say where an action happens.",
      "example_zh": "中午，我在学校吃饭。",
      "example_en": "At noon, I eat at school."
    }
  ],
  "questions": [
    {
