  "grammar_points": [
    {
      "pattern": "和……一样＋adjective",
      "explanation_en": "Means \"as (adjective) as ...\". Put the thing you compare with after 和, then 一样 and the adjective.",
      "example_zh": "我的弟弟和我一样高。",
      "example_en": "My younger brother is as tall as I am."
    },
    {
      "pattern": "因为……，才……",
      "explanation_en": "Gives a reason and stresses that something happened only at that point or under that condition. 才 means \"only then\".",
      "example_zh": "因为下雨了，我们才回家。",
      "example_en": "Because it rained, we only then went home."
    },
    {
      "pattern": "……的那一天",
      "explanation_en": "A clause before 的那一天 describes which day you mean, like \"the day when ...\".",
      "example_zh": "我到北京的那一天，天气很好。",
      "example_en": "On the day I arrived in Beijing, the weather was very nice."
    }
  ],
