  "grammar_points": [
    {
      "pattern": "都 (dōu) — \"both / all\"",
      "explanation_en": "Put 都 after the subject and before the verb to say that everyone in the group does the same thing. With 不, 我们都不… means \"none of us…\".",
      "example_zh": "我们都喜欢苹果。",
      "example_en": "We all like apples."
    },
    {
      "pattern": "也 (yě) — \"also\"",
      "explanation_en": "Put 也 after the subject and before the verb to add another thing that is the same. It can come before 都 as in 也都.",
      "example_zh": "我也想喝水。",
      "example_en": "I also want to drink water."
    },
    {
      "pattern": "去 + place + verb — \"go to a place to do something\"",
      "explanation_en": "Say where you go first, then what you do there.",
      "example_zh": "我们去学校看书。",
      "example_en": "We go to school to read."
    }
  ],
