  "grammar_points": [
    {
      "pattern": "V + 了 (completed action)",
      "explanation_en": "Put 了 after a verb to show an action has been completed. It is often used for past events.",
      "example_zh": "我昨天买了一本书。",
      "example_en": "I bought a book yesterday."
    },
    {
      "pattern": "给 + person + V + thing",
      "explanation_en": "给 means 'to give' or 'for'. Use 给 + person before a verb to show who receives the action or benefit.",
      "example_zh": "爸爸给我做了一个蛋糕。",
      "example_en": "Dad made me a cake."
    },
    {
      "pattern": "一件 + clothing (measure word)",
      "explanation_en": "Chinese uses measure words between a number and a noun. 件 is used for clothes such as shirts, coats and dresses.",
      "example_zh": "我想买一件白色的衣服。",
      "example_en": "I want to buy a white piece of clothing."
    }
