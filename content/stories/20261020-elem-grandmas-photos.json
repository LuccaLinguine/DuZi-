  "grammar_points": [
    {
      "pattern": "adjective + 得 + result",
      "explanation_en": "得 after an adjective tells you how strong the feeling was by showing what it caused. 高兴得没睡好 = so happy that she didn't sleep well.",
      "example_zh": "他累得不想说话。",
      "example_en": "He was so tired he didn't want to talk."
    },
    {
      "pattern": "……了 (change of state)",
      "explanation_en": "了 at the end of a sentence shows that something is now different from before. 不上班了 = doesn't go to work any more.",
      "example_zh": "天黑了，我们回家吧。",
      "example_en": "It's dark now, let's go home."
    },
    {
      "pattern": "没想到，……",
      "explanation_en": "Puts a surprise at the front of a sentence: \"I never expected that…\".",
      "example_zh": "没想到，今天这么冷。",
      "example_en": "I didn't expect it to be so cold today."
    }
  ],
  "questions": [
