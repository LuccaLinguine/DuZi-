  "grammar_points": [
    {
      "pattern": "只能 + verb phrase",
      "explanation_en": "只能 means 'can only' or 'may only'. It limits what is allowed or possible to a single option or group.",
      "example_zh": "晚上你只能看一个小时电视。",
      "example_en": "In the evening you can only watch TV for one hour."
    },
    {
      "pattern": "可以 / 不可以 + verb (permission)",
      "explanation_en": "可以 gives permission and 不可以 refuses it. Contrasting the two in parallel clauses shows what is and is not allowed.",
      "example_zh": "在这里可以拍照，不可以大声说话。",
      "example_en": "You may take photos here, but you may not talk loudly."
    },
    {
      "pattern": "……吗？ (yes/no question) with 能",
      "explanation_en": "Adding 吗 to the end of a statement turns it into a yes/no question. 能 asks whether something is possible or permitted.",
      "example_zh": "我能用你的手机吗？",
      "example_en": "Can I use your phone?"
    }
  ],
  "questions": [
