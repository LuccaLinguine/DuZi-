  "grammar_points": [
    {
      "pattern": "很多 + noun",
      "explanation_en": "很多 means \"many\" or \"a lot of\" and goes directly before a noun, without needing 的.",
      "example_zh": "我的城市有很多公园。",
      "example_en": "My city has many parks."
    },
    {
      "pattern": "会 + verb (will / tend to)",
      "explanation_en": "会 before a verb can show what people usually do or what will happen. In the text, it describes customs people follow.",
      "example_zh": "周末我们会去公园玩。",
      "example_en": "On weekends we go to the park to play."
    },
    {
      "pattern": "……的时候 (when / at the time of)",
      "explanation_en": "Put 的时候 after a time or an action to say \"when...\". The time phrase usually comes at the start of the sentence.",
      "example_zh": "下雨的时候，我在家看书。",
      "example_en": "When it rains, I read at home."
    }
  ],
  "questions": [
