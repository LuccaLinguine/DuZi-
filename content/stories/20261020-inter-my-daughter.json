  "grammar_points": [
    {
      "pattern": "每次……都……",
      "explanation_en": "Means 'every time... (always)...'. The first part names the occasion, and 都 shows it happens without exception.",
      "example_zh": "每次下雨，我都会带伞。",
      "example_en": "Every time it rains, I take an umbrella."
    },
    {
      "pattern": "因为……，（所以）……／……，因为……",
      "explanation_en": "Gives a reason. 因为 introduces the cause. In the text, the result comes first and the reason follows with 因为.",
      "example_zh": "他今天没来，因为他生病了。",
      "example_en": "He didn't come today, because he is sick."
    },
    {
      "pattern": "也 (also) with 很",
      "explanation_en": "也 adds another quality or action to what was just said. It goes before the verb or adjective, after the subject. Together with 很 it links two adjectives: 很……，也很……",
      "example_zh": "这家饭馆很便宜，也很干净。",
      "example_en": "This restaurant is very cheap and also very clean."
    }
  ],
  "questions": [
