  "grammar_points": [
    {
      "pattern": "A 比 B + 更 + adjective",
      "explanation_en": "Use 比 to compare two things. Adding 更 means 'even more' and stresses the difference.",
      "example_zh": "哥哥比弟弟更高。",
      "example_en": "The older brother is taller than the younger brother."
    },
    {
      "pattern": "Verb + 得 + 太/很 + adjective",
      "explanation_en": "After a verb, 得 introduces a description of how the action is done.",
      "example_zh": "她说得太快了。",
      "example_en": "She speaks too fast."
    },
    {
      "pattern": "如果……，……也……",
      "explanation_en": "如果 means 'if'. The second part often uses 也 or 就 to give the result or a similar result.",
      "example_zh": "如果明天下雨，我也不出去。",
      "example_en": "If it rains tomorrow, I won't go out either."
    }
  ],
