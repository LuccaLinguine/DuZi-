  "grammar_points": [
    {
      "pattern": "V + 得 + adj (complement of degree)",
      "explanation_en": "Put 得 after a verb to describe how an action is done or to what degree. The adjective after 得 tells the manner or result.",
      "example_zh": "妹妹跑得很快。",
      "example_en": "My younger sister runs very fast."
    },
    {
      "pattern": "不想再 + V",
      "explanation_en": "不想再 means 'don't want to ... anymore'. 再 shows the action would repeat or continue, and the speaker doesn't want that.",
      "example_zh": "我不想再吃了，已经很饱了。",
      "example_en": "I don't want to eat anymore; I'm already very full."
    },
    {
      "pattern": "V + 了 + duration, 就 ...",
      "explanation_en": "After an action lasting a certain amount of time, 就 introduces what happened next, often suggesting it happened quickly or soon.",
      "example_zh": "他看了十分钟书，就睡着了。",
      "example_en": "He read for ten minutes and then fell asleep."
    }
  ],
