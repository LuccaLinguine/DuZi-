  "grammar_points": [
    {
      "pattern": "送……给……",
      "explanation_en": "'送 + thing + 给 + person' means to give something to someone as a gift. The thing comes first and the recipient comes after 给. In sentence 2 the order is 送了一个冰淇淋给他, and in sentence 3 it is 送给你冰淇淋 (recipient first).",
      "example_zh": "朋友送了一本书给我。",
      "example_en": "My friend gave me a book as a gift."
    },
    {
      "pattern": "对……说",
      "explanation_en": "'对 + person + 说' means 'to say to someone'. It introduces who is being spoken to, and what is said follows after a colon in quotation marks.",
      "example_zh": "老师对学生说：“明天要考试。”",
      "example_en": "The teacher said to the students, \"There will be a test tomorrow.\""
    },
    {
      "pattern": "应该 + verb",
      "explanation_en": "应该 expresses what someone ought to do, based on manners, duty, or common sense. It is often used when teaching or reminding someone, as the mother does here.",
      "example_zh": "见到老师，你应该打招呼。",
      "example_en": "When you see your teacher, you should say hello."
    }
  ],
  "questions": [
    {
      "q_zh": "奶奶为什么送冰淇淋给孩子？",
