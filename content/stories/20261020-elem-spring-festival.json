  "grammar_points": [
    {
      "pattern": "虽然/但是 pattern: A，但是 B (contrast)",
      "explanation_en": "用 但是 to introduce a result that contrasts with the first part. Here the cold weather contrasts with people being happy. It means 'but'.",
      "example_zh": "今天很忙，但是我很开心。",
      "example_en": "I am very busy today, but I am happy."
    },
    {
      "pattern": "有……、有……，还有……",
      "explanation_en": "Use this to list several items. 有 names each item and 还有 adds one more at the end.",
      "example_zh": "桌子上有苹果、有茶，还有面包。",
      "example_en": "On the table there are apples, tea, and also bread."
    },
    {
      "pattern": "在……的时候 / 在一起 (time and place with 在)",
      "explanation_en": "在 can mark a time or a place. 在这一天 means 'on this day', and 在一起 means 'together'. 的时候 means 'when'.",
      "example_zh": "我吃饭的时候不看手机。",
      "example_en": "When I eat, I don't look at my phone."
    }
  ],
