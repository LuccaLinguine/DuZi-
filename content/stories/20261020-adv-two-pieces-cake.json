  "grammar_points": [
    {
      "pattern": "V + 成 (切成两半)",
      "explanation_en": "The structure 'verb + 成' shows something being changed or turned into a different form or result. What it becomes comes after 成.",
      "example_zh": "他把纸折成了一只小船。",
      "example_en": "He folded the paper into a little boat."
    },
    {
      "pattern": "给你 + quantity (给你一块蛋糕 / 给你，两块)",
      "explanation_en": "给 can be followed by a person and then the thing given, meaning 'give someone something.' In speech it can also be used on its own as 'here you go' when handing something over.",
      "example_zh": "我给你一杯热茶，喝吧。",
      "example_en": "I'll give you a cup of hot tea, so drink up."
    },
    {
      "pattern": "拿走 (verb + directional complement 走)",
      "explanation_en": "走 after a verb shows that something is taken or moved away from the speaker's place. 拿走 means 'take away.'",
      "example_zh": "服务员把空盘子拿走了。",
      "example_en": "The waiter took the empty plates away."
    }
  ],
