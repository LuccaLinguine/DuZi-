  "grammar_points": [
    {
      "pattern": "在 + place + verb",
      "explanation_en": "在 before a place names where an action happens, and goes right before the verb — not after it the way \"at\" often lands in English.",
      "example_zh": "她在学校学习。",
      "example_en": "She studies at school."
    },
    {
      "pattern": "给 + person + thing",
      "explanation_en": "给 (\"to give\") takes the receiver right after it, then the thing given — 给了他小的 is \"gave him the small one.\"",
      "example_zh": "我给了他一本书。",
      "example_en": "I gave him a book."
    },
    {
      "pattern": "verb + 了",
      "explanation_en": "了 right after a verb marks that the action is complete: 进来了 is \"came in (and is now here)\", 笑了 is \"laughed (just now)\".",
      "example_zh": "他来了。",
      "example_en": "He has arrived."
    }
  ],
