  "grammar_points": [
    {
      "pattern": "又 + verb (repeated action)",
      "explanation_en": "又 is used for an action that has happened again, already repeated. It goes before the verb.",
      "example_zh": "他昨天迟到了，今天又迟到了。",
      "example_en": "He was late yesterday, and he was late again today."
    },
    {
      "pattern": "在 + verb (action in progress)",
      "explanation_en": "在 before a verb shows that an action is happening right now.",
      "example_zh": "妈妈在做饭，爸爸在看电视。",
      "example_en": "Mom is cooking, and Dad is watching TV."
    },
    {
      "pattern": "过了一会儿",
      "explanation_en": "过了一会儿 means 'after a little while'. It links two events and shows that a short time passed between them.",
      "example_zh": "我们坐下来，过了一会儿，菜就来了。",
      "example_en": "We sat down, and after a little while, the food came."
    }
  ],
  "questions": [
