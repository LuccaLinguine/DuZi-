  "grammar_points": [
    {
      "pattern": "只有……(都)没/不……",
      "explanation_en": "\"只有\" means \"only\" and singles out one person or thing. Here it is paired with \"都\" earlier in the sentence to contrast \"everyone\" with \"only me\".",
      "example_zh": "大家都去了，只有我没去。",
      "example_en": "Everyone went; only I didn't go."
    },
    {
      "pattern": "V + 进 + place (direction complement)",
      "explanation_en": "\"进\" after a verb shows movement into something. \"掉进\" means to fall into. \"了\" at the end shows the event has happened.",
      "example_zh": "小猫跳进了盒子里。",
      "example_en": "The kitten jumped into the box."
    },
    {
      "pattern": "不能 + verb",
      "explanation_en": "\"不能\" means \"must not\" or \"cannot\", used for rules or what is not acceptable to do. \"当然\" (of course) can be added for emphasis.",
      "example_zh": "在教室里我们不能大声说话。",
      "example_en": "In the classroom we must not talk loudly."
    }
  ],
